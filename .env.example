# The assistant runs on a local Ollama model. The first start downloads it once (about 2 GB for
# the default); it is kept in the ollama-models volume. Any Ollama model with tool calling works,
# written with its tag as on ollama.com.
LLM_MODEL=qwen2.5:3b

# Dashboard sign-in. The defaults below are the demo values from docker-compose.yml.
SESSION_SECRET=demo-session-secret
VIEWER_PASSWORD=viewer
OPERATOR_PASSWORD=operator
ADMIN_PASSWORD=admin
