flowchart LR
    subgraph inbound["Inbound: signed webhooks"]
        shopIn["Electronic Market<br/>order.placed, order.cancelled"]
        emagIn["eMAG<br/>notification: order id and type"]
        whIn["Bucharest warehouse<br/>order.shipped, stock.adjusted"]
    end
    subgraph glue["Glue: one FastAPI process, :8000"]
        inbox["Inbox<br/>check signature and schema,<br/>save, answer 202"]
        db[("SQLite<br/>inbox, orders, stock,<br/>review queue, audit log")]
        worker["Worker<br/>10 slots, one event<br/>per order at a time"]
        router["Router<br/>only writer of order status"]
        rec["Reconciler<br/>warehouse stock to both channels"]
        review["Review queue<br/>retry, cancel, dismiss"]
        api["JSON API<br/>session, roles, CSRF header"]
        ai["Assistant and triage<br/>read-only tools"]
        retry["One retry policy<br/>timeouts, back-off,<br/>Retry-After"]
    end
    subgraph outbound["Outbound API calls"]
        whOut["Bucharest warehouse API<br/>reserve, Idempotency-Key<br/>cancel, read stock"]
        emagOut["eMAG API<br/>order/read, acknowledge, status,<br/>product_offer/save batch"]
        shopOut["Electronic Market API<br/>stock per product, ship, cancel"]
    end
    operator((Operator)) --> ui["React dashboard<br/>served by the glue"]
    ollama["Ollama, local model<br/>qwen2.5:3b"]

    shopIn --> inbox
    emagIn --> inbox
    whIn --> inbox
    inbox --> db
    db --> worker
    worker --> router
    worker --> rec
    router --> retry
    rec --> retry
    retry --> whOut
    retry --> emagOut
    retry --> shopOut
    router -.-> review
    ui --> api
    api --> review
    api --> ai
    ai --> ollama
